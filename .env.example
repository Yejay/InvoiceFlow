# ===========================================
# InvoiceFlow Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs (these are correct, no need to change)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase Database
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Resend E-Mail API
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# For development: use onboarding@resend.dev (no domain verification needed)
# For production: verify your domain at https://resend.com/domains
RESEND_FROM_EMAIL=onboarding@resend.dev

# Rechnungs API (ZUGFeRD E-Invoice Generation)
# Get your API key from https://www.rechnungs-api.de/
# Free tier: 10 invoices/month
# Use test_ keys for development, prod_ keys for production
RECHNUNGS_API_KEY=test_...
